FROM devkitpro/devkitppc:latest

LABEL org.opencontainers.image.source="https://github.com/baldbuffalo/webkit-wiiu"
ENV DEBIAN_FRONTEND=noninteractive

# Build this layer once and reuse it from the GHCR BuildKit registry cache.
# Normal WebKit workflow runs then start inside a container that already has
# all host-side build tools installed; no apt upgrade/install is needed in the
# cross-compilation job itself.
RUN apt-get update -q \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        cmake \
        ninja-build \
        python3 \
        python3-pip \
        python3-venv \
        libicu-dev \
        libssl-dev \
        libcurl4-openssl-dev \
        libsqlite3-dev \
        libpsl-dev \
        libxml2-dev \
        gperf \
        ruby \
        perl \
        ccache \
        skopeo \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
